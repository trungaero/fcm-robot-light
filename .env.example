# Copy to .env and fill in your key (used by docker-compose).
OPENAI_API_KEY=sk-your-key-here
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_INSTRUCTIONS=You are a friendly, concise voice assistant. Keep replies short and conversational.
OPENAI_SAFETY_IDENTIFIER=voice-chat-demo

# WebRTC ICE configuration (needed when backend/frontend are on different
# machines or behind NAT). STUN has a safe default; add TURN if the direct
# media path is blocked (e.g. symmetric NAT, or the Docker simulation below).
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
