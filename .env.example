# Copy to .env and fill in your key (used by docker-compose).
OPENAI_API_KEY=sk-your-key-here
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_INSTRUCTIONS=You are a friendly, concise voice assistant. Keep replies short and conversational.
OPENAI_SAFETY_IDENTIFIER=voice-chat-demo
