# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-your-key-here

# Realtime model. "gpt-realtime-mini" is the cheap tier; switch to
# "gpt-realtime-2.1" for higher quality. Any dated variant works too.
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Output voice (e.g. marin, alloy, verse).
OPENAI_REALTIME_VOICE=marin

# System prompt for the assistant.
OPENAI_INSTRUCTIONS=You are a friendly, concise voice assistant. Keep replies short and conversational.

# Optional, privacy-preserving end-user id sent to OpenAI.
OPENAI_SAFETY_IDENTIFIER=voice-chat-demo

# Server bind settings.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
