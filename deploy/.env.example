# Reference for the .env that cloud-init writes to /opt/voice-chat/.env on the
# VM. You do not normally edit this file directly — set the values in
# terraform.tfvars (see terraform/terraform.tfvars.example).
#
# Only the backend is deployed to the VM; the frontend runs locally.

OPENAI_API_KEY=sk-your-key-here
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_INSTRUCTIONS=You are a friendly, concise voice assistant. Keep replies short and conversational.
OPENAI_SAFETY_IDENTIFIER=voice-chat-demo

# WebRTC ICE. STUN has a safe default; add a TURN server for reliable media
# behind symmetric NAT (see README "Further considerations").
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
