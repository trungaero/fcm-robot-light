# Caddy reverse proxy for the voice-chat backend.
#
# Terminates TLS on :443 for the signaling path (/ws + /health) and forwards
# everything to the backend's host-network socket at 127.0.0.1:8000. WebRTC
# media (SRTP/UDP) is peer-to-peer and never passes through Caddy.
#
# The certificate is self-signed and generated by cloud-init at boot (see
# terraform/templates/cloud-init.yaml.tpl). A static cert plus a hostless site
# address is required because clients such as curl and Node's Vite proxy do NOT
# send SNI when connecting to an IP literal, and Caddy's automatic/internal
# certificate management cannot select a certificate without SNI.
#
# Caddy upgrades WebSocket connections automatically; no extra directives are
# needed for the /ws endpoint.

:443 {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
    reverse_proxy 127.0.0.1:8000
}
