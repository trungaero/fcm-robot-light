# Copy to frontend/.env (or .env.local) and set these when the backend runs on
# a remote VM. When unset, the Vite dev server proxies to localhost:8000.

# Backend signaling WebSocket URL (used as the /ws proxy target).
# TLS is terminated by Caddy on the VM (self-signed cert); the Vite dev proxy
# is configured with `secure: false` to accept it (see vite.config.ts).
VITE_BACKEND_WS_URL=wss://<VM_PUBLIC_IP>

# Backend HTTP URL (used as the /health proxy target).
VITE_BACKEND_HTTP_URL=https://<VM_PUBLIC_IP>
