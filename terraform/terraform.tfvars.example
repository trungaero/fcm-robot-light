# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# git-ignored so secrets never get committed.
location            = "southeastasia"
resource_group_name = "voice-chat-rg"
vm_size             = "Standard_D4s_v3"
admin_username      = "azureuser"

# Absolute path (Terraform's file() does not expand "~").
ssh_public_key = "/home/trung/.ssh/id_rsa.pub"

openai_api_key = "sk-REPLACE_WITH_YOUR_OPENAI_API_KEY"

# Optional overrides:
# openai_realtime_model = "gpt-realtime-mini"
# openai_realtime_voice = "marin"
# webrtc_turn_url       = "turn:turn.example.com:3478"
# webrtc_turn_username  = "user"
# webrtc_turn_credential = "secret"
